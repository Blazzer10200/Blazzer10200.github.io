{
	"name": "braison-swilling",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "node scripts/prepare-build.mjs",
		"build": "vite build",
		"build:static": "node scripts/build-static.mjs",
		"pdf": "node scripts/generate-pdf.mjs",
		"build:pdf": "node scripts/build-static.mjs && node scripts/generate-pdf.mjs",
		"preview": "vite preview",
		"preview:worker": "wrangler dev .svelte-kit/cloudflare/_worker.js",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test": "npm run test:unit",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"verify": "npm run format:check && npm run lint && npm run check && npm run test:unit && npm run build && npm run test:e2e"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260804.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"eslint": "^10.8.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.1.0",
		"vitest": "^4.1.10",
		"wrangler": "^4.119.0"
	},
	"overrides": {
		"cookie": "0.7.2",
		"undici": "7.29.0"
	}
}
