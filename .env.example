# Public build-time origin. Keep the GitHub Pages URL until the custom domain is verified.
PUBLIC_SITE_URL=https://blazzer10200.github.io

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Inquiry delivery
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
DESTINATION_EMAIL=
SENDER_IDENTITY=

# Optional future storage binding name. Configure the actual D1 binding in wrangler.jsonc.
INQUIRY_DATABASE_BINDING=INQUIRIES_DB
